# Copy to .env and fill in real values. Never commit .env itself (see .gitignore).

# Postgres connection string shared by all three collector instances
# (BTC/ETH/SOL). When unset, the collector falls back to a local SQLite
# file per asset (data/analyzer_<asset>.db) -- fine for local dev, not for
# a deployed/unattended run.
POLY_ANALYZER_DSN=postgresql://user:password@host:port/dbname

# Which underlying this instance tracks: btc / eth / sol / all (default).
# When deploying as three separate services from the same repo/Start
# Command, set this to a different value per service instead of overriding
# the Start Command. --asset on the command line still takes precedence
# over this if both are given.
POLY_ANALYZER_ASSET=all
